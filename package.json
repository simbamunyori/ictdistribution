{
  "name": "ictdistribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-brand.mjs",
    "prebuild": "node scripts/copy-brand.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "copy-check": "tsx scripts/check-copy.ts",
    "check": "npm run lint && npm run typecheck && npm run copy-check && npm test",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "ops": "tsx scripts/ops.ts",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "nodemailer": "^10.0.10",
    "pg-boss": "^10.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright-core": "1.56.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2"
  }
}
