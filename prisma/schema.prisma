// ICT Distribution Africa data model.
//
// Rules this schema encodes:
// - Money is a BigInt in the currency's minor unit with a currency code
//   beside it. Never a float. Exchange rates are exact decimal text.
// - Business rules (price levels, markets, currencies, rate checks) are
//   rows edited in the admin area, never constants in code.
// - Every customer account row belongs to one Organisation and is read
//   through tenantDb(), which adds the organisation filter. Individuals
//   buy as themselves, with no organisation.
// - AuditEvent rows are never edited or deleted (enforced by a trigger).
// - Supplier names, costs and sourcing never appear in a customer-facing
//   page. They live only in the Supplier* and PriceList* models, which
//   only staff pages read (src/server/suppliers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Markets and currencies ──────────────────────────────────────────

/// A currency we can price in. Added in /admin/markets.
model Currency {
  /// ISO 4217, e.g. "BWP".
  code      String   @id
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markets   Market[]
  suppliers Supplier[]
}

/// A country we sell in. Decides currency, how amounts and dates are
/// written, and the price conversion rules. Edited in /admin/markets.
model Market {
  /// "bw", "za", "zw". Lower-case ISO 3166-1 alpha-2 of the country.
  code              String   @id
  name              String
  /// ISO 3166-1 alpha-2, upper case.
  country           String   @unique
  currency          String
  /// BCP 47, for writing money and dates, e.g. "en-BW".
  locale            String
  timeZone          String
  enabled           Boolean  @default(false)
  /// Where visitors go when their country isn't one of ours. Exactly one.
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  /// Basis points added to the exchange rate when converting our base
  /// prices, to cover the rate moving before we pay. 200 is 2%.
  fxBufferBps       Int      @default(200)
  /// Converted prices are rounded up to a multiple of this many minor
  /// units. 100 in BWP rounds up to the next whole pula; 0 or 1 leaves them.
  roundToMinor      Int      @default(100)
  supportEmail      String?
  /// The sales tax in shop prices, e.g. "VAT". Shop prices include it.
  taxName           String   @default("VAT")
  /// 1,400 is 14%.
  taxRateBps        Int      @default(0)
  /// Our tax registration number in this market, printed on tax invoices.
  taxNumber         String   @default("")
  /// Delivery to an address: the fee in the market's currency, free from an order total.
  deliveryEnabled   Boolean  @default(false)
  deliveryFeeMinor  BigInt   @default(0)
  freeDeliveryMinor BigInt?
  /// What customers can expect, e.g. "2 to 4 working days in Gaborone".
  deliveryNote      String   @default("")
  /// Shown with every bank transfer order. Empty switches bank transfer off here.
  bankDetails       String   @default("")
  updatedAt         DateTime @updatedAt

  currencyRef      Currency          @relation(fields: [currency], references: [code], onDelete: Restrict)
  organisations    Organisation[]
  users            User[]
  collectionPoints CollectionPoint[]
  specials         Special[]
  orders           Order[]
  customerPrices   CustomerPrice[]
  quotes           Quote[]
}

/// Where customers in a market can collect an order.
model CollectionPoint {
  id         String  @id @default(cuid())
  marketCode String
  name       String
  address    String
  hours      String  @default("")
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  market Market  @relation(fields: [marketCode], references: [code], onDelete: Cascade)
  orders Order[]

  @@index([marketCode])
}

/// Settings that apply to every market. One row, id "global".
model PricingSettings {
  id              String       @id @default("global")
  /// The currency our catalogue prices are kept in. Customers see theirs.
  baseCurrency    String       @default("USD")
  /// A new rate that moves more than this since the one in use is held back
  /// for an Admin or Finance to accept. 1,000 is 10%.
  rateJumpHoldBps Int          @default(1000)
  /// Rates older than this many hours raise a warning to staff.
  rateMaxAgeHours Int          @default(48)
  /// When rates were last fetched, and why the last try failed.
  ratesCheckedAt  DateTime?
  ratesError      String?
  /// How a product's supplier is chosen when neither it nor its category
  /// says otherwise. Edited in /admin/sourcing.
  sourcingRule    SourcingRule @default(CHEAPEST_LANDED)
  updatedAt       DateTime     @updatedAt
}

/// One exchange rate as fetched: 1 base = rate quote, as exact decimal
/// text. The newest row for a pair that isn't held back is the one in use.
model ExchangeRate {
  id           String    @id @default(cuid())
  base         String
  quote        String
  rate         String
  /// Where it came from, e.g. "open.er-api.com", or "staff" when typed.
  source       String
  /// When the source says the rate was published.
  publishedAt  DateTime
  fetchedAt    DateTime  @default(now())
  /// Why it isn't used yet, e.g. a jump too large to trust. Null when it is.
  heldBack     String?
  acceptedById String?
  acceptedAt   DateTime?

  @@index([base, quote, fetchedAt])
}

// ─── Customer types ──────────────────────────────────────────────────

enum CustomerTypeCode {
  INDIVIDUAL
  BUSINESS
  RESELLER
  GOVERNMENT
}

/// The four kinds of customer. Each has its own price level, set in
/// /admin/customer-types. The category markups, volume breaks and
/// per-customer prices of D4 build on this.
model CustomerType {
  code          CustomerTypeCode @id
  name          String
  description   String
  /// Markup on our cost for this price level, in basis points. 2,500 is 25%.
  markupBps     Int
  /// Business types are organisations with their own users.
  organisation  Boolean
  /// Individuals may check out without an account.
  guestCheckout Boolean          @default(false)
  sortOrder     Int              @default(0)
  updatedAt     DateTime         @updatedAt

  organisations   Organisation[]
  categoryMarkups CategoryMarkup[]
  volumeBreaks    VolumeBreak[]
}

/// A price level's markup for one category (and the categories under it), in place of the level's own.
model CategoryMarkup {
  id           String           @id @default(cuid())
  customerType CustomerTypeCode
  categoryId   String
  markupBps    Int
  updatedAt    DateTime         @updatedAt

  type     CustomerType @relation(fields: [customerType], references: [code], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([customerType, categoryId])
}

/// Buy at least this many of one product and pay this much less per unit. Optionally only in one category.
model VolumeBreak {
  id           String           @id @default(cuid())
  customerType CustomerTypeCode
  categoryId   String?
  minQuantity  Int
  discountBps  Int
  createdAt    DateTime         @default(now())

  type     CustomerType @relation(fields: [customerType], references: [code], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([customerType])
}

// ─── People and organisations ────────────────────────────────────────

enum UserKind {
  /// A shopper, or someone at a customer organisation.
  CUSTOMER
  /// ICT Distribution Africa staff. Signs in to /admin only.
  STAFF
}

enum StaffRole {
  /// Everything, including settings, staff accounts and the audit log.
  ADMIN
  /// Customers, quotes and orders.
  SALES
  /// Suppliers, prices from suppliers and purchase orders.
  PROCUREMENT
  /// Shipments, warehouses and deliveries.
  LOGISTICS
  /// Exchange rates, credit, invoices and payments.
  FINANCE
  /// Customer questions, returns and account help.
  SUPPORT
}

model User {
  id              String     @id @default(cuid())
  kind            UserKind   @default(CUSTOMER)
  /// Stored lower-cased.
  email           String     @unique
  name            String
  phone           String?
  /// The market an individual shops in. Organisations carry their own.
  marketCode      String?
  emailVerifiedAt DateTime?
  /// Staff only.
  staffRole       StaffRole?
  deactivatedAt   DateTime?
  lastSignInAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  market          Market?            @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  memberships     Membership[]
  sessions        Session[]
  identities      ExternalIdentity[]
  passkeys        Passkey[]
  invitationsSent StaffInvitation[]  @relation("staffInvitedBy")
  staffInvitation StaffInvitation?   @relation("staffInvitationAccepted")
  savedLists      SavedList[]
}

enum OrgRole {
  /// Everything, including the team and the company details.
  OWNER
  /// Places orders and asks for quotes.
  BUYER
  /// Invoices, statements and payments.
  FINANCE
  /// Sees everything, changes nothing.
  VIEWER
}

/// A business customer: a company, reseller or government or enterprise
/// buyer, with its own users.
model Organisation {
  id                 String             @id @default(cuid())
  name               String
  customerType       CustomerTypeCode   @default(BUSINESS)
  /// ISO 3166-1 alpha-2.
  country            String
  marketCode         String
  registrationNumber String?
  taxNumber          String?
  /// Registered address, for invoices.
  address            String             @default("")
  /// One per line.
  directors          String             @default("")
  verification       VerificationStatus @default(NOT_SUBMITTED)
  submittedAt        DateTime?
  verifiedAt         DateTime?
  verifiedByLabel    String?
  /// Why staff could not approve it, shown to the customer.
  verificationNote   String?
  /// Credit, set by Finance, in the organisation's market currency. Null: no credit.
  creditLimitMinor   BigInt?
  /// Days to pay an order bought on account.
  creditTermsDays    Int?
  /// Stops new orders on account, whatever the limit.
  creditOnHold       Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  type               CustomerType           @relation(fields: [customerType], references: [code], onDelete: Restrict)
  market             Market                 @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  memberships        Membership[]
  invitations        Invitation[]
  documents          OrganisationDocument[]
  customerPrices     CustomerPrice[]
  creditApplications CreditApplication[]
  orders             Order[]
  quotes             Quote[]
  invoices           Invoice[]
  returns            ReturnRequest[]
  savedLists         SavedList[]

  @@index([customerType])
  @@index([verification])
}

enum VerificationStatus {
  NOT_SUBMITTED
  /// Sent for checking.
  PENDING
  APPROVED
  /// Sent back with a note; the customer can correct it and send again.
  REJECTED
}

enum DocumentKind {
  REGISTRATION
  TAX
  DIRECTOR_ID
  ADDRESS
  OTHER
}

/// A document a business sends to be checked. Kept in the database like product media; staff only.
model OrganisationDocument {
  id              String       @id @default(cuid())
  organisationId  String
  kind            DocumentKind
  filename        String
  contentType     String
  bytes           Bytes
  size            Int
  uploadedByLabel String
  createdAt       DateTime     @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// A price agreed with one customer for one product, including tax, in that market's currency.
model CustomerPrice {
  id             String    @id @default(cuid())
  organisationId String
  productId      String
  marketCode     String
  priceMinor     BigInt
  validUntil     DateTime?
  note           String    @default("")
  createdByLabel String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  market       Market       @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@unique([organisationId, productId, marketCode])
}

enum CreditApplicationStatus {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

model CreditApplication {
  id                  String                  @id @default(cuid())
  organisationId      String
  status              CreditApplicationStatus @default(PENDING)
  /// In the organisation's market currency.
  requestedLimitMinor BigInt
  requestedTermsDays  Int
  /// Monthly spend, trade references and anything else Finance should know.
  details             String                  @default("")
  appliedByLabel      String
  decidedAt           DateTime?
  decidedByLabel      String?
  /// Shown to the customer.
  decisionNote        String?
  createdAt           DateTime                @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Membership {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           OrgRole
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organisationId, userId])
  @@index([userId])
}

/// An emailed invitation to join an organisation. Only the hash of the
/// link's token is stored; the link is made when the email is sent.
model Invitation {
  id             String    @id @default(cuid())
  organisationId String
  /// Stored lower-cased.
  email          String
  role           OrgRole
  tokenHash      String?   @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
}

/// An invitation for a colleague to set up their own staff account.
model StaffInvitation {
  id          String    @id @default(cuid())
  /// Stored lower-cased.
  email       String
  name        String
  staffRole   StaffRole
  tokenHash   String?   @unique
  /// Null for the first Admin, made on the server with `ictd create-admin`.
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  userId      String?   @unique
  createdAt   DateTime  @default(now())

  invitedBy User? @relation("staffInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  user      User? @relation("staffInvitationAccepted", fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
}

// ─── Sign-in ─────────────────────────────────────────────────────────

enum SessionStage {
  /// Staff: email or Microsoft accepted; waiting for their passkey.
  PASSKEY_PENDING
  /// Staff without a passkey yet: must add one before anything else.
  PASSKEY_SETUP
  /// Fully signed in.
  ACTIVE
}

/// A browser session. Only the SHA-256 hash of the cookie value is stored.
model Session {
  id                   String       @id @default(cuid())
  tokenHash            String       @unique
  userId               String
  /// Mirrors the user's kind, so a customer cookie can never open /admin.
  audience             UserKind
  stage                SessionStage
  /// The organisation a business user is buying for. Null: buying for themselves.
  activeOrganisationId String?
  expiresAt            DateTime
  lastSeenAt           DateTime     @default(now())
  revokedAt            DateTime?
  /// When this session last passed a passkey or email code. Changing sign-in
  /// methods and staff settings need one in the last 15 minutes.
  stepUpAt             DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A six-digit code emailed to prove someone owns an address. Only an
/// HMAC of the code is kept; it works once, for ten minutes, five tries.
model EmailCode {
  id        String    @id @default(cuid())
  /// Stored lower-cased.
  email     String
  audience  UserKind
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

enum IdentityProvider {
  MICROSOFT
  GOOGLE
}

/// A Microsoft or Google account someone signs in with.
model ExternalIdentity {
  id         String           @id @default(cuid())
  userId     String
  provider   IdentityProvider
  /// Microsoft "tid:oid", Google "sub".
  subject    String
  email      String
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
}

/// A passkey (WebAuthn credential): fingerprint, face or device PIN.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  /// base64url credential id, as the browser reports it.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Audit ───────────────────────────────────────────────────────────

enum ActorKind {
  CUSTOMER
  STAFF
  SYSTEM
}

/// Everything that changed, by whom. Never edited or deleted. Rows about
/// a business customer carry its organisationId; rows about one person
/// carry subjectUserId.
model AuditEvent {
  id                String    @id @default(cuid())
  organisationId    String?
  subjectUserId     String?
  actorKind         ActorKind
  actorUserId       String?
  /// The name at the time, so the log still reads well if the person leaves.
  actorLabel        String
  /// Dotted name, e.g. "market.updated".
  action            String
  targetType        String?
  targetId          String?
  /// One plain sentence.
  summary           String
  data              Json?
  /// Shown to the customer in their account history.
  visibleToCustomer Boolean   @default(false)
  ipAddress         String?
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([organisationId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([action, createdAt])
}

// ─── Email ───────────────────────────────────────────────────────────

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Every email we send, queued in the same transaction as the change that
/// caused it and sent by a background job. Secrets (codes, invitation
/// links) are sealed in the payload and removed once sent.
model OutboundEmail {
  id            String      @id @default(cuid())
  kind          String
  toAddress     String
  payload       Json
  subject       String?
  status        EmailStatus @default(QUEUED)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
}

// ─── Catalogue ───────────────────────────────────────────────────────

/// A category, or a subcategory one level below one. Managed in
/// /admin/categories.
model Category {
  id           String        @id @default(cuid())
  /// In the address, e.g. "laptops". Unique across all categories.
  slug         String        @unique
  name         String
  description  String        @default("")
  parentId     String?
  sortOrder    Int           @default(0)
  /// Hidden categories, and everything in them, stay out of the shop.
  active       Boolean       @default(true)
  /// How to choose a supplier for products here. Null follows the parent, then the global rule.
  sourcingRule SourcingRule?
  /// Customs tariff (HS) code for commercial invoices. Empty follows the parent.
  hsCode       String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  parent       Category?            @relation("subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]           @relation("subcategories")
  specFields   SpecField[]
  products     Product[]
  suppliers    SupplierCategory[]
  /// Categories whose products we suggest alongside these, e.g. memory for laptops.
  suggests     CategorySuggestion[] @relation("suggestFrom")
  suggestedBy  CategorySuggestion[] @relation("suggestTo")
  specials     Special[]
  markups      CategoryMarkup[]
  volumeBreaks VolumeBreak[]
  quoteLines   QuoteLine[]
  dutyRules    DutyRule[]

  @@index([parentId, sortOrder])
}

/// "Products in this category go well with products in that one."
model CategorySuggestion {
  categoryId String
  relatedId  String

  category Category @relation("suggestFrom", fields: [categoryId], references: [id], onDelete: Cascade)
  related  Category @relation("suggestTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([categoryId, relatedId])
}

enum SpecKind {
  TEXT
  NUMBER
  YES_NO
  /// One of a fixed list of options.
  CHOICE
}

/// A specification every product in a category carries, such as "Memory"
/// in GB for laptops. Subcategories inherit their parent's.
model SpecField {
  id         String   @id @default(cuid())
  categoryId String
  /// Stable name the product's values are kept under, e.g. "memory_gb".
  key        String
  label      String
  kind       SpecKind
  /// Written after numbers, e.g. "GB".
  unit       String   @default("")
  /// For CHOICE: the options, in order.
  options    String[]
  /// Shoppers can filter by it.
  filterable Boolean  @default(true)
  /// Shown on product cards.
  highlight  Boolean  @default(false)
  /// Suggested items must have the same value, e.g. the memory type.
  mustMatch  Boolean  @default(false)
  sortOrder  Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

enum ProductStatus {
  /// Being prepared. Only staff see it.
  DRAFT
  /// In the shop.
  ACTIVE
  /// No longer sold. Kept for orders and history.
  ARCHIVED
}

/// Something we sell, under our brand. Never carries supplier details:
/// those are on SupplierOffer.
model Product {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  brandId           String
  /// Manufacturer part number, as the manufacturer writes it.
  mpn               String
  /// The part number upper-cased with spaces, dashes and dots removed, for matching price lists.
  mpnKey            String
  categoryId        String
  summary           String        @default("")
  description       String        @default("")
  /// Values by SpecField key: text, number or true/false.
  specs             Json          @default("{}")
  warrantyMonths    Int?
  /// e.g. "Manufacturer, carry-in".
  warrantyTerms     String        @default("")
  /// Shown with a price to everyone in the shop (D3). Others ask shoppers to register a business.
  sellToIndividuals Boolean       @default(false)
  status            ProductStatus @default(DRAFT)
  /// How to choose its supplier. Null follows the category, then the global rule.
  sourcingRule      SourcingRule?
  /// Name, brand, part number, category and specification values, lower-cased, for search.
  searchText        String        @default("")
  /// Internal: the chosen supplier's landed cost in the base currency and
  /// lead time, kept current by refreshCosts. Null when no offer can be used.
  landedCostMinor   BigInt?
  leadTimeDays      Int?
  costRefreshedAt   DateTime?
  /// Shipping weight and boxed size of one unit, for freight estimates. Empty: the supplier's allowance is used.
  weightGrams       Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  brand          Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media          ProductMedia[]
  offers         SupplierOffer[]
  links          ProductLink[]    @relation("linkFrom")
  linkedBy       ProductLink[]    @relation("linkTo")
  featured       FeaturedProduct?
  specials       SpecialItem[]
  cartLines      CartLine[]
  orderLines     OrderLine[]
  customerPrices CustomerPrice[]
  quoteLines     QuoteLine[]
  stock          StockLevel[]
  stockMovements StockMovement[]
  savedListLines SavedListLine[]

  @@unique([brandId, mpn])
  @@index([mpnKey])
  @@index([categoryId, status])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum MediaKind {
  IMAGE
  DATASHEET
}

/// A product image or datasheet. Kept in the database, so every backup
/// has them. Images are resized to WebP when uploaded.
model ProductMedia {
  id          String    @id @default(cuid())
  productId   String
  kind        MediaKind
  /// The name it was uploaded with, for downloads.
  filename    String
  contentType String
  bytes       Bytes
  /// IMAGE: a small copy for product cards.
  thumb       Bytes?
  width       Int?
  height      Int?
  size        Int
  /// IMAGE: what it shows, for people who can't see it. DATASHEET: its title.
  alt         String    @default("")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind, sortOrder])
}

/// Two products that go together, shown on both. Stored once, lower id first.
model ProductLink {
  productId String
  relatedId String
  createdAt DateTime @default(now())

  product Product @relation("linkFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("linkTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId])
  @@index([relatedId])
}

// ─── Suppliers (staff only) ──────────────────────────────────────────

enum SupplierKind {
  LOCAL
  INTERNATIONAL
  CHINA
}

enum SourcingRule {
  /// Lowest cost once freight, duties and clearing are added.
  CHEAPEST_LANDED
  /// Shortest lead time.
  FASTEST
  /// Suppliers marked preferred first, then the cheapest of them.
  PREFERRED
}

/// Who we buy from. Internal only: never shown to customers.
model Supplier {
  id            String       @id @default(cuid())
  name          String       @unique
  kind          SupplierKind
  /// ISO 3166-1 alpha-2.
  country       String
  /// The currency they bill in.
  currency      String
  email         String?
  /// International format, e.g. +8613800000000.
  whatsapp      String?
  phone         String?
  website       String?
  /// Their trade or ordering portal.
  portalUrl     String?
  notes         String       @default("")
  /// Typical days from order to goods in our hands, when an offer doesn't say.
  leadTimeDays  Int
  /// Smallest order they accept, in their currency, when they have one.
  minOrderMinor BigInt?
  /// Freight, duties and clearing added to their cost, in basis points,
  /// until D7 works it out per shipment. 1,500 is 15%.
  landedCostBps Int          @default(0)
  /// How their goods usually travel to us, for freight estimates.
  freightMode   ShipMode     @default(ROAD)
  preferred     Boolean      @default(false)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  currencyRef    Currency               @relation(fields: [currency], references: [code], onDelete: Restrict)
  contacts       SupplierContact[]
  categories     SupplierCategory[]
  offers         SupplierOffer[]
  events         SupplierEvent[]
  format         PriceListFormat?
  imports        PriceListImport[]
  quoteLines     QuoteLine[]
  rfqs           SupplierPriceRequest[]
  orderLines     OrderLine[]
  purchaseOrders PurchaseOrder[]
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  role       String   @default("")
  email      String?
  phone      String?
  whatsapp   String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

/// The categories a supplier supplies.
model SupplierCategory {
  supplierId String
  categoryId String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
}

enum SupplierEventKind {
  ON_TIME
  LATE
  QUALITY_ISSUE
  WRONG_ITEM
  NOTE
}

/// The supplier's performance record: deliveries, problems and notes.
/// D6 adds a row for each purchase order received.
model SupplierEvent {
  id              String            @id @default(cuid())
  supplierId      String
  kind            SupplierEventKind
  occurredAt      DateTime
  note            String            @default("")
  /// Their invoice or our order number, when there is one.
  reference       String?
  recordedById    String?
  recordedByLabel String
  createdAt       DateTime          @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, occurredAt])
}

/// What one supplier charges us for one product.
model SupplierOffer {
  id             String   @id @default(cuid())
  supplierId     String
  productId      String
  /// Their own code for it, when it differs from the part number.
  supplierSku    String?
  /// In `currency`, minor units, before freight and duties.
  costMinor      BigInt
  currency       String
  /// Null uses the supplier's typical lead time.
  leadTimeDays   Int?
  /// Minimum order quantity.
  moq            Int      @default(1)
  /// Units they last said they have. Null when they don't say.
  stock          Int?
  active         Boolean  @default(true)
  /// "staff" when typed, "import" from a price list.
  source         String
  priceUpdatedAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

enum ImportSchedule {
  OFF
  DAILY
  WEEKLY
}

/// How to read one supplier's price list. Saved with the first import
/// and reused for every one after it.
model PriceListFormat {
  supplierId        String         @id
  /// Column heading for each field, e.g. {"mpn": "Part No", "cost": "Dealer Price"}.
  columns           Json
  /// Excel: the sheet to read. Null reads the first.
  sheet             String?
  /// The row holding the column headings, from 1.
  headerRow         Int            @default(1)
  /// Prices in the list are in this currency. Null: the supplier's.
  currency          String?
  /// Scheduled re-imports fetch the list from this https address.
  sourceUrl         String?
  schedule          ImportSchedule @default(OFF)
  /// A scheduled list applies itself when no price moves more than this,
  /// in basis points. Null: always wait for review.
  autoApplyBps      Int?
  /// Offers missing from a new list are switched off when it is applied.
  deactivateMissing Boolean        @default(false)
  lastFetchedAt     DateTime?
  lastFetchError    String?
  updatedAt         DateTime       @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

enum ImportStatus {
  /// Uploaded, waiting for staff to say which column is which.
  NEEDS_COLUMNS
  /// Read and waiting for review.
  READY
  APPLIED
  DISCARDED
}

/// One price list, read and compared with what we have, waiting to be
/// applied or already applied.
model PriceListImport {
  id             String       @id @default(cuid())
  supplierId     String
  filename       String
  /// "upload" or "schedule".
  origin         String
  /// The file as received. Cleared from older imports to save space.
  file           Bytes?
  status         ImportStatus @default(READY)
  /// Counts by change, e.g. {"PRICE_UP": 3}.
  summary        Json         @default("{}")
  /// The largest price move among matched lines, in basis points.
  largestMoveBps Int?
  createdById    String?
  createdByLabel String
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?
  decidedByLabel String?

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rows     PriceListRow[]

  @@index([supplierId, createdAt])
}

enum RowChange {
  /// A product we have that this supplier didn't offer before.
  NEW_OFFER
  PRICE_UP
  PRICE_DOWN
  UNCHANGED
  /// No product matches its part number.
  UNMATCHED
  /// Something in the line can't be read.
  INVALID
  /// We have an offer from this supplier that the list no longer has.
  MISSING
}

model PriceListRow {
  id                String    @id @default(cuid())
  importId          String
  /// The line in the file. 0 for MISSING.
  line              Int
  change            RowChange
  mpn               String
  brand             String?
  name              String?
  supplierSku       String?
  costMinor         BigInt?
  currency          String
  stock             Int?
  leadTimeDays      Int?
  moq               Int?
  productId         String?
  previousCostMinor BigInt?
  movedBps          Int?
  error             String?

  import PriceListImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, change, line])
}

// ─── D3: shop, specials, cart and orders ─────────────────────────────

/// Shop-wide settings. One row, id "global". Edited at /admin/shop.
model ShopSettings {
  id              String   @id @default("global")
  heroTitle       String   @default("ICT for work and home, delivered across Southern Africa")
  heroText        String   @default("Laptops, phones, monitors and the rest, at clear prices. Businesses get trade pricing and quotes.")
  /// Days a bank transfer order waits for payment before it is cancelled.
  payDays         Int      @default(3)
  /// The most of one item in one order.
  maxLineQuantity Int      @default(10)
  orderPrefix     String   @default("ICT")
  /// Days after an order is sent or made ready that a return can be asked for. Faulty items are not limited by it.
  returnDays      Int      @default(14)
  updatedAt       DateTime @updatedAt
}

/// Products on the shop's home page, in order.
model FeaturedProduct {
  productId String   @id
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum SpecialKind {
  /// One product at a special price.
  PRODUCT
  /// A percentage off everything in a category.
  CATEGORY
  /// Several products together at one price.
  BUNDLE
}

/// A special offer with dates, an optional limit and the customer types it is for.
model Special {
  id            String             @id @default(cuid())
  slug          String             @unique
  name          String
  description   String             @default("")
  kind          SpecialKind
  /// For CATEGORY specials. Includes its subcategories.
  categoryId    String?
  /// A percentage off, in basis points. 1,500 is 15%. Either this or priceMinor.
  discountBps   Int?
  /// A fixed price including tax, in the market's currency. Needs a market.
  priceMinor    BigInt?
  /// Only in this market. Null: every market.
  marketCode    String?
  startsAt      DateTime
  endsAt        DateTime
  /// Units (or bundles) it covers in total. Null: no limit.
  quantityLimit Int?
  /// Units (or bundles) taken by orders that weren't cancelled.
  quantityUsed  Int                @default(0)
  /// The most one order may take at this price.
  perOrderLimit Int?
  customerTypes CustomerTypeCode[]
  /// Shown on the shop's home page.
  featured      Boolean            @default(false)
  /// Switched off by staff, whatever the dates.
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  category  Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  market    Market?       @relation(fields: [marketCode], references: [code], onDelete: Cascade)
  items     SpecialItem[]
  cartLines CartLine[]

  @@index([active, endsAt])
}

/// The product of a PRODUCT special, or each product of a BUNDLE.
model SpecialItem {
  specialId String
  productId String
  quantity  Int    @default(1)

  special Special @relation(fields: [specialId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([specialId, productId])
  @@index([productId])
}

/// A shopping cart, found by the hash of the token in its cookie.
model Cart {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lines     CartLine[]

  @@index([updatedAt])
}

/// A product, or a bundle special, in a cart.
model CartLine {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  bundleId  String?
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle  Special? @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@unique([cartId, bundleId])
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  /// Bought on account: to send now, paid by its due date.
  ON_ACCOUNT
  /// Sent, or ready to collect.
  FULFILLED
  CANCELLED
}

enum Fulfilment {
  DELIVERY
  COLLECTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  /// The organisation's credit terms.
  ACCOUNT
}

model Order {
  id                String           @id @default(cuid())
  /// e.g. ICT-100042. Shown to the customer and used as the payment reference.
  number            String           @unique
  status            OrderStatus      @default(AWAITING_PAYMENT)
  marketCode        String
  currency          String
  customerType      CustomerTypeCode
  userId            String?
  organisationId    String?
  email             String
  name              String
  phone             String
  fulfilment        Fulfilment
  addressLine1      String           @default("")
  addressLine2      String           @default("")
  city              String           @default("")
  postalCode        String           @default("")
  collectionPointId String?
  /// The accepted quote it was made from, if any.
  quoteId           String?          @unique
  /// Shop orders show prices with tax; orders from quotes show them before
  /// tax, with the tax added on the total, as the quote did.
  pricesIncludeTax  Boolean          @default(true)
  /// When its purchase orders were made, once it was paid or put on account.
  procuredAt        DateTime?
  /// The collection point's name, address and hours when ordered.
  collectionText    String           @default("")
  paymentMethod     PaymentMethod
  /// What to pay into, as shown when ordered.
  bankDetails       String           @default("")
  notes             String           @default("")
  /// The buyer's own reference, such as a purchase order number.
  customerReference String           @default("")
  /// Lines, including tax.
  subtotalMinor     BigInt
  deliveryMinor     BigInt
  totalMinor        BigInt
  /// The tax included in the total.
  taxMinor          BigInt
  taxName           String
  taxRateBps        Int
  /// The secret in the link we email, for guests to see their order.
  accessTokenHash   String           @unique
  payBy             DateTime?
  paidAt            DateTime?
  fulfilledAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  market          Market           @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  organisation    Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  collectionPoint CollectionPoint? @relation(fields: [collectionPointId], references: [id], onDelete: SetNull)
  lines           OrderLine[]
  payments        OrderPayment[]
  quote           Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  purchaseOrders  PurchaseOrder[]
  deliveries      Delivery[]
  invoice         Invoice?
  returns         ReturnRequest[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([organisationId, paymentMethod])
  @@index([email])
}

model OrderLine {
  id                 String        @id @default(cuid())
  orderId            String
  productId          String?
  /// For bundle lines, the special.
  bundleId           String?
  description        String
  mpn                String        @default("")
  quantity           Int
  /// Including tax, in the order's currency.
  unitPriceMinor     BigInt
  /// The usual price when a special applied.
  listUnitPriceMinor BigInt?
  lineTotalMinor     BigInt
  specialId          String?
  specialName        String?
  /// How many of the quantity were at the special price.
  specialUnits       Int           @default(0)
  /// Internal: landed cost per unit in the base currency when ordered, for margins.
  unitCostBaseMinor  BigInt?
  /// Internal: the supplier and their price per unit (in their currency)
  /// agreed when quoting. Empty for shop orders, which buy from the
  /// supplier the sourcing rule picks when the purchase order is made.
  supplierId         String?
  supplierCostMinor  BigInt?
  supplierCurrency   String?
  sortOrder          Int           @default(0)
  /// Where it is on its way to the customer. Empty until it is ordered or taken from stock.
  tracking           LineTracking?
  /// Taken from our stock rather than bought for this order.
  fromStock          Boolean       @default(false)

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poLines        PurchaseOrderLine[]
  trackingEvents TrackingEvent[]
  deliveryLines  DeliveryLine[]
  stockMovements StockMovement[]
  returnLines    ReturnLine[]

  @@index([orderId])
}

/// Money received for an order, recorded by Finance (or by a card gateway later).
model OrderPayment {
  id              String        @id @default(cuid())
  orderId         String
  method          PaymentMethod
  amountMinor     BigInt
  reference       String        @default("")
  receivedOn      DateTime
  recordedByLabel String
  createdAt       DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── D5: automated quotations ────────────────────────────────────────

/// Rules for quotes, edited by an Admin at /admin/quotes/rules. One row, id "global".
model QuoteSettings {
  id                  String   @id @default("global")
  /// Quotes inside every rule below go out without anyone checking them.
  automationEnabled   Boolean  @default(true)
  /// The largest quote that goes out by itself, in the base currency, before tax.
  maxAutoValueMinor   BigInt   @default(500000)
  /// The smallest margin a quote may have to go out by itself. 800 is 8%.
  minMarginBps        Int      @default(800)
  /// How sure a line's match to a catalogue product must be, 0 to 100.
  minMatchConfidence  Int      @default(90)
  /// Hours suppliers have to answer a request for price.
  supplierHours       Int      @default(24)
  /// The same, for urgent requests.
  urgentSupplierHours Int      @default(6)
  /// Days a quote stays valid.
  validityDays        Int      @default(14)
  /// Markup on tenders, in place of the customer's price level. Null: their level.
  tenderMarkupBps     Int?
  /// Markup on reseller projects, in place of the customer's price level. Null: their level.
  projectMarkupBps    Int?
  /// Sales are reminded this many hours before a tender closes.
  tenderReminderHours Int      @default(72)
  quotePrefix         String   @default("Q")
  updatedAt           DateTime @updatedAt
}

enum QuoteType {
  STANDARD
  RESELLER_PROJECT
  /// A government or enterprise tender, with a reference, a deadline and required documents.
  TENDER
}

enum QuoteSource {
  PORTAL
  EMAIL
  STAFF
}

enum QuoteStatus {
  /// Waiting to be read into lines.
  RECEIVED
  /// Requests for price are out to suppliers.
  WAITING_ON_SUPPLIERS
  /// Priced, but outside the automation rules: a person checks it and sends it.
  REVIEW
  SENT
  ACCEPTED
  DECLINED
  /// Not accepted before it ran out.
  EXPIRED
  CANCELLED
}

/// A request for quote and the quotation made from it.
model Quote {
  id                String           @id @default(cuid())
  /// e.g. Q-100042.
  number            String           @unique
  type              QuoteType        @default(STANDARD)
  source            QuoteSource
  status            QuoteStatus      @default(RECEIVED)
  marketCode        String
  currency          String
  /// The price level it is priced at.
  customerType      CustomerTypeCode
  userId            String?
  organisationId    String?
  email             String
  name              String
  phone             String           @default("")
  /// The buyer's company, as they wrote it, when they are not a business account.
  companyName       String           @default("")
  customerReference String           @default("")
  urgent            Boolean          @default(false)
  tenderReference   String           @default("")
  tenderDeadline    DateTime?
  /// Documents the tender asks for, one per line.
  requiredDocuments String           @default("")
  /// Datasheets and warranty details go with the quote.
  includeDocuments  Boolean          @default(false)
  /// Typed or pasted lines, or the body of the email.
  requestText       String           @default("")
  fileName          String?
  fileType          String?
  file              Bytes?
  /// Why it needs a person, one reason per line. Null when it doesn't.
  reviewReasons     String?
  supplierDeadline  DateTime?
  /// Prices: lines before tax, the tax on them, and the total, in `currency`.
  subtotalMinor     BigInt?
  taxMinor          BigInt?
  totalMinor        BigInt?
  taxName           String           @default("VAT")
  taxRateBps        Int              @default(0)
  /// Internal: landed cost of the lines in the base currency, and the margin it leaves.
  costBaseMinor     BigInt?
  marginBps         Int?
  /// Days from order to delivery, the longest line.
  leadTimeDays      Int?
  paymentTerms      String           @default("")
  bankDetails       String           @default("")
  validUntil        DateTime?
  /// The secret in the link we email.
  accessTokenHash   String?          @unique
  readAt            DateTime?
  pricedAt          DateTime?
  sentAt            DateTime?
  /// "Automatically", or the person who sent it.
  sentByLabel       String?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  declineReason     String?
  cancelledAt       DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  market        Market                 @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  organisation  Organisation?          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  lines         QuoteLine[]
  priceRequests SupplierPriceRequest[]
  order         Order?

  @@index([status, createdAt])
  @@index([organisationId])
  @@index([userId])
  @@index([email])
}

enum CostSource {
  /// A current supplier offer in the catalogue.
  CATALOGUE
  /// A supplier's answer to our request for price.
  SUPPLIER
  /// Typed by staff.
  STAFF
}

model QuoteLine {
  id                String      @id @default(cuid())
  quoteId           String
  position          Int
  /// The line as the customer wrote it.
  original          String
  description       String
  mpn               String      @default("")
  quantity          Int
  productId         String?
  /// The product's category, or our best guess for a line we don't list.
  categoryId        String?
  /// How sure the match to `productId` is, 0 to 100. Staff confirming it makes it 100.
  matchConfidence   Int         @default(0)
  /// Unclear: a person must check it before the quote can go.
  flagReason        String?
  costSource        CostSource?
  /// Internal: who we would buy it from, and its landed cost per unit in the base currency.
  supplierId        String?
  unitCostBaseMinor BigInt?
  leadTimeDays      Int?
  /// A price set by staff, before tax, in the quote's currency. Null: worked out from the cost.
  priceOverride     BigInt?
  /// Before tax, in the quote's currency.
  unitPriceMinor    BigInt?
  lineTotalMinor    BigInt?

  quote     Quote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  category  Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier  Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  responses SupplierQuoteResponse[]

  @@index([quoteId, position])
}

enum ReachChannel {
  EMAIL
  WHATSAPP
}

enum PriceRequestStatus {
  /// Emailed; waiting for their answer.
  SENT
  /// WhatsApp until the Fourth Generation hub is live: staff send the link by hand.
  TO_SEND_BY_HAND
  RESPONDED
  /// The deadline passed without an answer.
  EXPIRED
  /// The quote no longer needs it.
  CLOSED
}

/// A request for price to one supplier for some lines of one quote. Internal only.
model SupplierPriceRequest {
  id          String             @id @default(cuid())
  quoteId     String
  supplierId  String
  /// Short code in the email subject, so a plain reply finds its way back, e.g. RFQ-7K2M9Q.
  reference   String             @unique
  channel     ReachChannel
  status      PriceRequestStatus
  /// The quote lines it asks about.
  lineIds     String[]
  tokenHash   String             @unique
  /// The link's token, sealed with the app key, so staff can send it by hand.
  tokenSealed String
  deadline    DateTime
  sentAt      DateTime?
  respondedAt DateTime?
  /// Their general note, and a plain email reply as received.
  note        String             @default("")
  replyText   String?
  createdAt   DateTime           @default(now())

  quote     Quote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  supplier  Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  responses SupplierQuoteResponse[]

  @@index([quoteId])
  @@index([status, deadline])
}

/// One supplier's price for one quote line.
model SupplierQuoteResponse {
  id           String    @id @default(cuid())
  requestId    String
  lineId       String
  /// They can't supply it.
  noOffer      Boolean   @default(false)
  /// Per unit, in `currency`, before freight and duties.
  costMinor    BigInt?
  currency     String
  available    Int?
  leadTimeDays Int?
  validUntil   DateTime?
  notes        String    @default("")
  /// "page", "email" or "staff".
  source       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  request SupplierPriceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  line    QuoteLine            @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([requestId, lineId])
  @@index([lineId])
}

/// Every email read from the quotes mailbox, once, and what was done with it.
model InboundEmail {
  id          String   @id @default(cuid())
  messageId   String   @unique
  fromAddress String
  subject     String
  /// "quote-request", "supplier-reply" or "ignored".
  outcome     String
  quoteId     String?
  requestId   String?
  note        String   @default("")
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([fromAddress, createdAt])
}

// ─── D6: procurement ─────────────────────────────────────────────────

/// The Admin's rules for purchase orders (singleton "global").
model ProcurementSettings {
  id                String   @id @default("global")
  /// Send purchase orders without anyone approving them, within the rules below.
  autoSend          Boolean  @default(false)
  /// The most a purchase order sent by itself can be worth, in the base currency.
  maxAutoValueMinor BigInt   @default(200000)
  /// Only to suppliers marked preferred.
  onlyPreferred     Boolean  @default(true)
  poPrefix          String   @default("PO")
  /// Where suppliers deliver, printed on every purchase order.
  deliverTo         String   @default("")
  /// Our payment terms with suppliers, printed on every purchase order.
  paymentTerms      String   @default("")
  /// Fill orders from our stock when enough is free, before buying.
  useStock          Boolean  @default(true)
  /// Ask suppliers to deliver straight to customers for delivery orders.
  dropShipByDefault Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

enum PurchaseOrderStatus {
  /// Waiting for staff to approve and send it.
  AWAITING_APPROVAL
  /// Approved; the supplier has no email, so staff send it on WhatsApp.
  TO_SEND_BY_HAND
  SENT
  /// The supplier confirmed it.
  CONFIRMED
  SHIPPED
  /// The goods reached us.
  RECEIVED
  CANCELLED
}

/// What we buy from one supplier for one order.
model PurchaseOrder {
  id                String              @id @default(cuid())
  number            String              @unique
  orderId           String
  supplierId        String
  status            PurchaseOrderStatus
  channel           ReachChannel
  /// The supplier's currency.
  currency          String
  totalMinor        BigInt
  /// Internal: what it is worth in the base currency, for the rules.
  totalBaseMinor    BigInt?
  /// Why it waits for approval, one reason per line.
  reviewReasons     String?
  /// The supplier's link to their page for this order.
  tokenHash         String              @unique
  tokenSealed       String
  approvedByLabel   String?
  sentAt            DateTime?
  confirmedAt       DateTime?
  supplierReference String              @default("")
  expectedShipDate  DateTime?
  shippedAt         DateTime?
  /// Waybill or tracking number.
  shippingReference String              @default("")
  supplierNote      String              @default("")
  receivedAt        DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  /// The supplier delivers straight to the customer instead of to our warehouse.
  dropShip          Boolean             @default(false)
  /// Where it is delivered when not drop-shipped.
  warehouseId       String?
  /// The inbound shipment it travels in, once staff group it.
  shipmentId        String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order     Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supplier  Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]
  documents PurchaseOrderDocument[]
  warehouse Warehouse?              @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  shipment  Shipment?               @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id                String    @id @default(cuid())
  purchaseOrderId   String
  orderLineId       String?
  /// The product bought, when it is one of ours (for stock).
  productId         String?
  position          Int
  description       String
  mpn               String    @default("")
  quantity          Int
  /// In the purchase order's currency, before tax.
  unitCostMinor     BigInt
  lineTotalMinor    BigInt
  /// What the supplier confirmed they will send, when it differs.
  confirmedQuantity Int?
  shipDate          DateTime?
  /// Serial numbers of the units sent, one per line.
  serials           String    @default("")
  note              String    @default("")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  orderLine     OrderLine?    @relation(fields: [orderLineId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId, position])
}

enum PoDocumentKind {
  INVOICE
  PACKING_LIST
  OTHER
}

/// A supplier's invoice, packing list or other paper for a purchase order. Kept in the database so backups include it.
model PurchaseOrderDocument {
  id              String         @id @default(cuid())
  purchaseOrderId String
  kind            PoDocumentKind
  filename        String
  contentType     String
  size            Int
  bytes           Bytes
  uploadedByLabel String
  createdAt       DateTime       @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

// ─── Logistics (D7) ──────────────────────────────────────────────────

enum ShipMode {
  AIR
  SEA
  ROAD
  COURIER
}

/// How freight, insurance, duties and clearing are estimated. Set at /admin/logistics/rules.
model LogisticsSettings {
  id                 String   @id @default("global")
  /// Where goods are landed, for duties: the default warehouse's country, else this.
  homeCountry        String   @default("BW")
  defaultWarehouseId String?
  /// Kilograms charged per cubic metre of volume, by mode (volumetric weight).
  airKgPerM3         Int      @default(167)
  courierKgPerM3     Int      @default(200)
  roadKgPerM3        Int      @default(333)
  seaKgPerM3         Int      @default(1000)
  /// Insurance as basis points of the goods value, when the history has none.
  insuranceBps       Int      @default(50)
  /// How many recent shipments on a route and mode an estimate uses.
  sampleSize         Int      @default(20)
  /// Printed on commercial invoices, e.g. "DAP Gaborone".
  incoterm           String   @default("DAP")
  updatedAt          DateTime @updatedAt
}

enum ShipmentSource {
  /// A past shipment typed in or imported, for estimates only.
  HISTORY
  /// A shipment we are tracking now, with its purchase orders.
  LIVE
}

enum ShipmentStatus {
  BOOKED
  IN_TRANSIT
  AT_CUSTOMS
  CLEARED
  ARRIVED
}

/// Goods coming to us: one consignment on one route and mode, with what
/// it weighed and cost. Arrived ones teach the freight estimates.
model Shipment {
  id                 String         @id @default(cuid())
  /// e.g. SH-100001.
  number             String         @unique
  source             ShipmentSource
  status             ShipmentStatus @default(BOOKED)
  mode               ShipMode
  /// ISO 3166-1 alpha-2, upper case.
  originCountry      String
  destinationCountry String
  carrier            String         @default("")
  /// Waybill, bill of lading or tracking number.
  reference          String         @default("")
  weightGrams        Int
  volumeCm3          Int            @default(0)
  /// The currency the costs below were paid in.
  currency           String
  goodsValueMinor    BigInt?
  freightMinor       BigInt         @default(0)
  insuranceMinor     BigInt         @default(0)
  dutiesMinor        BigInt         @default(0)
  clearingMinor      BigInt         @default(0)
  otherMinor         BigInt         @default(0)
  shippedOn          DateTime?
  arrivedOn          DateTime?
  /// Days from leaving the supplier to arriving, when the dates aren't known.
  transitDays        Int?
  notes              String         @default("")
  createdByLabel     String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([originCountry, destinationCountry, mode, status])
}

/// Staff's own figure for a route and mode, used instead of the estimate from history.
model FreightOverride {
  id                 String   @id @default(cuid())
  originCountry      String
  destinationCountry String
  mode               ShipMode
  /// Freight per chargeable kilogram, in the base currency.
  perKgMinor         BigInt?
  /// Clearing and other fees per chargeable kilogram, in the base currency.
  feesPerKgMinor     BigInt?
  transitDays        Int?
  note               String   @default("")
  updatedByLabel     String
  updatedAt          DateTime @updatedAt

  @@unique([originCountry, destinationCountry, mode])
}

/// Import duty for a category (or every category, when empty) landed in a country.
model DutyRule {
  id                 String   @id @default(cuid())
  categoryId         String?
  destinationCountry String
  /// Duty on the customs value (cost, insurance and freight), in basis points.
  dutyBps            Int      @default(0)
  /// Other levies on the customs value, in basis points.
  leviesBps          Int      @default(0)
  /// Origins that pay no duty here, such as SACU members.
  exemptOrigins      String[] @default([])
  note               String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, destinationCountry])
}

enum LineTracking {
  ORDERED
  SHIPPED
  IN_TRANSIT
  AT_CUSTOMS
  CLEARED
  IN_WAREHOUSE
  OUT_FOR_DELIVERY
  DELIVERED
}

/// One step on an order line's way to the customer, shown to them.
model TrackingEvent {
  id          String       @id @default(cuid())
  orderLineId String
  status      LineTracking
  note        String       @default("")
  byLabel     String
  at          DateTime     @default(now())

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([orderLineId, at])
}

model Warehouse {
  id        String   @id @default(cuid())
  /// Short name, e.g. GBE.
  code      String   @unique
  name      String
  /// ISO 3166-1 alpha-2, upper case.
  country   String
  address   String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock          StockLevel[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  deliveries     Delivery[]
}

/// How many of a product are in a warehouse, and how many of those are kept for orders.
model StockLevel {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  onHand      Int      @default(0)
  allocated   Int      @default(0)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
}

enum StockMovementKind {
  /// Goods in from a purchase order.
  RECEIVED
  /// Kept for an order line.
  ALLOCATED
  /// Out to a customer.
  ISSUED
  /// Counted, found or written off.
  ADJUSTED
}

model StockMovement {
  id              String            @id @default(cuid())
  warehouseId     String
  productId       String
  kind            StockMovementKind
  /// Positive in, negative out. For ALLOCATED, the units kept.
  quantity        Int
  orderLineId     String?
  purchaseOrderId String?
  note            String            @default("")
  byLabel         String
  at              DateTime          @default(now())

  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)

  @@index([warehouseId, productId, at])
}

enum DeliveryStatus {
  PREPARED
  DISPATCHED
  DELIVERED
}

/// Goods going to a customer (or ready to collect), with its delivery note and proof of delivery.
model Delivery {
  id             String         @id @default(cuid())
  /// e.g. DN-100001.
  number         String         @unique
  orderId        String
  warehouseId    String?
  status         DeliveryStatus @default(PREPARED)
  carrier        String         @default("")
  reference      String         @default("")
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  /// Who signed for it.
  receivedBy     String         @default("")
  podFilename    String?
  podContentType String?
  podBytes       Bytes?
  createdByLabel String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines     DeliveryLine[]

  @@index([orderId])
  @@index([status, createdAt])
}

model DeliveryLine {
  id          String @id @default(cuid())
  deliveryId  String
  orderLineId String
  quantity    Int

  delivery  Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, orderLineId])
}

// ─── D8: customer portal ─────────────────────────────────────────────

/// The tax invoice for an order, issued once when the order is sent or
/// made ready. What it is for is the order's lines; who it is made out
/// to is kept as it was on the day.
model Invoice {
  id              String   @id @default(cuid())
  /// e.g. INV-100001.
  number          String   @unique
  orderId         String   @unique
  userId          String?
  organisationId  String?
  currency        String
  totalMinor      BigInt
  taxMinor        BigInt
  /// Name, organisation and address, one per line.
  billTo          String
  /// The customer's tax number, when they have one.
  taxNumber       String   @default("")
  issuedAt        DateTime
  /// The order's due date on account, else the day it was issued.
  dueAt           DateTime
  /// The secret in the link we email, so it opens without signing in.
  accessTokenHash String   @unique
  createdAt       DateTime @default(now())

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, issuedAt])
  @@index([userId, issuedAt])
}

enum ReturnReason {
  FAULTY
  DAMAGED
  WRONG_ITEM
  NOT_NEEDED
  OTHER
}

enum ReturnStatus {
  /// Asked for by the customer, waiting for us.
  REQUESTED
  /// Agreed: the customer sends the items back.
  APPROVED
  DECLINED
  /// The items are back with us.
  RECEIVED
  /// Settled: refunded, replaced or repaired, as the note says.
  CLOSED
  /// Withdrawn by the customer before we answered.
  CANCELLED
}

/// A customer's request to send items from an order back.
model ReturnRequest {
  id               String       @id @default(cuid())
  /// e.g. RMA-100001.
  number           String       @unique
  orderId          String
  userId           String?
  organisationId   String?
  status           ReturnStatus @default(REQUESTED)
  reason           ReturnReason
  /// What is wrong, in the customer's words.
  details          String
  requestedByLabel String
  /// Our answer, shown to the customer: how to send it back, why not, or how it was settled.
  note             String       @default("")
  decidedByLabel   String?
  decidedAt        DateTime?
  receivedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  lines        ReturnLine[]

  @@index([orderId])
  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReturnLine {
  id          String @id @default(cuid())
  returnId    String
  orderLineId String
  quantity    Int

  request   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderLineId])
}

/// Products a customer buys again and again. An organisation's lists are
/// shared by its team; a person's own lists are theirs alone.
model SavedList {
  id             String   @id @default(cuid())
  name           String
  /// Who made it.
  userId         String
  /// Null: the person's own list.
  organisationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation?   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lines        SavedListLine[]

  @@index([organisationId])
  @@index([userId])
}

model SavedListLine {
  id        String   @id @default(cuid())
  listId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  list    SavedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([listId, productId])
}
