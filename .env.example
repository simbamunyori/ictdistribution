# Copy to .env for development: cp .env.example .env
# Production values are written by deploy/server-setup.sh (docs/deploy.md).

# PostgreSQL and Redis (docker-compose.yml runs both locally).
DATABASE_URL=postgresql://ictd:ictd@localhost:5432/ictd
REDIS_URL=redis://localhost:6379
# The tests empty and reseed this one, so it must end in _test (README.md).
TEST_DATABASE_URL=postgresql://ictd:ictd@localhost:5432/ictd_test

# 32 random bytes, base64: openssl rand -base64 32
# Seals short-lived cookies and codes waiting in the email queue. Secret.
APP_SECRET=

# The public address. Passkeys belong to this host, so it can't change later without people adding them again.
APP_URL=http://localhost:3000

# Outgoing mail. Mailpit from docker-compose.yml in development; unset prints emails to the console.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="ICT Distribution Africa <no-reply@localhost>"

# Automated quotations (docs/quotes.md). Without ANTHROPIC_API_KEY, rules read requests and flag what they can't.
# The site assistant (docs/assistant.md) uses the same key; without it, rules answer.
# Without IMAP_URL, requests come only from the portal and supplier replies only from their response page.
ANTHROPIC_API_KEY=
QUOTES_EMAIL=
IMAP_URL=

# Requests for price to suppliers on WhatsApp, and their replies (WhatsApp Business Cloud API; docs/quotes.md, "WhatsApp").
# Unset: suppliers with only a WhatsApp number wait in the staff queue with an "Open in WhatsApp" button.
# WHATSAPP_TOKEN: the permanent system user token from Meta Business settings. Secret.
# WHATSAPP_PHONE_NUMBER_ID: the id of the business number (not the number itself), from the app's WhatsApp > API setup.
# WHATSAPP_TEMPLATE: the name of the approved request-for-price template, e.g. price_request.
# WHATSAPP_TEMPLATE_LANGUAGE: the template's language code as approved, e.g. en or en_US.
# WHATSAPP_APP_SECRET: the app's secret (App settings > Basic), to check webhook signatures. Secret.
# WHATSAPP_VERIFY_TOKEN: any long random text, typed again in the app's webhook settings. Secret.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# The legal entity that trades (not decided yet; docs/ICTD_BUILD.md, decision 1).
COMPANY_LEGAL_NAME="ICT Distribution Africa"

# Sign in with Microsoft and Google (docs/sign-in-setup.md). Buttons hide while unset.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_STAFF_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exchange rates: open-er-api (free, no key) or off to type them at /admin/exchange-rates.
RATE_SOURCE=open-er-api

# Optional
# GEO_COUNTRY_HEADER=cf-ipcountry
# ADMIN_IP_ALLOWLIST=196.45.0.0/16,41.79.0.10
# JOBS=off
