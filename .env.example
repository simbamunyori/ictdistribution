# Copy to .env for development: cp .env.example .env
# Production values are written by deploy/server-setup.sh (docs/deploy.md).

# PostgreSQL and Redis (docker-compose.yml runs both locally).
DATABASE_URL=postgresql://ictd:ictd@localhost:5432/ictd
REDIS_URL=redis://localhost:6379
# The tests empty and reseed this one, so it must end in _test (README.md).
TEST_DATABASE_URL=postgresql://ictd:ictd@localhost:5432/ictd_test

# 32 random bytes, base64: openssl rand -base64 32
# Seals short-lived cookies and codes waiting in the email queue. Secret.
APP_SECRET=

# The public address. Passkeys belong to this host, so it can't change later without people adding them again.
APP_URL=http://localhost:3000

# Outgoing mail. Mailpit from docker-compose.yml in development; unset prints emails to the console.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="ICT Distribution Africa <no-reply@localhost>"

# The legal entity that trades (not decided yet; docs/ICTD_BUILD.md, decision 1).
COMPANY_LEGAL_NAME="ICT Distribution Africa"

# Sign in with Microsoft and Google (docs/sign-in-setup.md). Buttons hide while unset.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_STAFF_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exchange rates: open-er-api (free, no key) or off to type them at /admin/exchange-rates.
RATE_SOURCE=open-er-api

# Optional
# GEO_COUNTRY_HEADER=cf-ipcountry
# ADMIN_IP_ALLOWLIST=196.45.0.0/16,41.79.0.10
# JOBS=off
